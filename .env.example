# Groq API for LLM generation (text and voice answers)
GROQ_API_KEY=

# Sarvam AI for speech-to-text (voice input only)
SARVAM_API_KEY=

# Qdrant endpoint. Docker Compose starts local Qdrant at this address.
# For Qdrant Cloud, replace this with the cluster URL and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Server port
PORT=3000
